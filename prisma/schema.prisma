generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Quote {
  id        Int      @id @default(autoincrement())
  text      String
  author    String
  createdAt DateTime @default(now())

  @@index([author])
}